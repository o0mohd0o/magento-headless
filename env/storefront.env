# Storefront (Next.js) container environment — headless/isolated topology.
#
# Server-side reads (RSC + the /api/graphql BFF route) hit Magento PRIVATELY
# over the Docker network. This URL is never exposed to the browser and the
# public domain answers /graphql with 404.
MAGENTO_GRAPHQL_URL=http://app:8181/graphql
MAGENTO_STORE_CODE=default

# Browser-side client components call the same-origin Next BFF route, which
# proxies to MAGENTO_GRAPHQL_URL server-side. The browser never sees Magento.
NEXT_PUBLIC_MAGENTO_GRAPHQL_URL=/api/graphql

# Public bases (served through the app front-door over TLS).
NEXT_PUBLIC_MEDIA_URL=https://magento.test/media/
NEXT_PUBLIC_SITE_URL=https://magento.test
NEXT_PUBLIC_LOCALE=en-US
