# Copy to .env.local and adjust for your environment.

# Magento GraphQL endpoint (server-only, used by RSC reads). No CORS needed.
MAGENTO_GRAPHQL_URL=https://magento.test/graphql
MAGENTO_STORE_CODE=default

# Node must trust the Magento (mkcert) TLS cert for server-side fetch.
# Put your mkcert root CA at storefront/certs/magento-rootCA.pem (see SETUP.md):
#   mkdir -p certs && cp "$(mkcert -CAROOT)/rootCA.pem" certs/magento-rootCA.pem
NODE_EXTRA_CA_CERTS=./certs/magento-rootCA.pem

# Public media base (safe to expose) — used to build image URLs.
NEXT_PUBLIC_MEDIA_URL=https://magento.test/media/

# Same-origin GraphQL proxy (src/app/api/graphql) used by browser-side client
# components (the page-builder product grids) so they don't hit the self-signed
# Magento cert directly. Leave as-is.
NEXT_PUBLIC_MAGENTO_GRAPHQL_URL=/api/graphql

# Public site URL — used for canonical/OpenGraph/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store locale for number/currency formatting (from Magento storeConfig.locale).
NEXT_PUBLIC_LOCALE=en-US
